# Sufret Omi environment template
# No real credentials are included here.
# Server-required values are marked below; Expo public variables are optional aliases.

# Required for server/database operation
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# Shared MySQL pool size per application instance; tune with the database provider.
DB_POOL_SIZE=10
JWT_SECRET=replace_with_a_long_random_secret
OAUTH_SERVER_URL=https://your-auth-provider.example.com
VITE_APP_ID=replace_with_oauth_app_id
OWNER_OPEN_ID=replace_with_owner_open_id

# Required for current Manus Forge storage implementation
BUILT_IN_FORGE_API_URL=https://your-forge-endpoint.example.com
BUILT_IN_FORGE_API_KEY=replace_with_storage_api_key

# Optional identity/display value used by environment mapping
OWNER_NAME=System Owner

# Runtime/server settings
NODE_ENV=development
PORT=3000
EXPO_PORT=8081

# Optional Expo public aliases generated by scripts/load-env.js
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Expo/runtime values normally supplied by Expo or the deployment platform
EXPO_OS=
EXPO_PACKAGER_PROXY_URL=
EXPO_WEB_PREVIEW_URL=

# Optional independent-storage replacement; unused by the current Manus Forge adapter
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# SMS order confirmations (optional; configure either a generic REST provider or Twilio-compatible credentials)
SMS_PROVIDER_URL=https://your-sms-provider.example.com/messages
SMS_PROVIDER_API_KEY=replace_with_sms_provider_key
SMS_PROVIDER_ACCOUNT_SID=replace_with_twilio_account_sid
SMS_PROVIDER_AUTH_TOKEN=replace_with_twilio_auth_token
SMS_PROVIDER_FROM_NUMBER=+9627XXXXXXXX

# Payment, maps, and analytics provider keys are not referenced by the current source code.
